# ════════════════════════════════════════════
# NINABOT — Configuration
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════

# Your IBKR account number (starts with U)
IBKR_ACCOUNT=UXXXXXXXX

# TWS connection
TWS_HOST=127.0.0.1
TWS_PORT=7496          # 7496 = live | 7497 = paper trading
TWS_CLIENT_ID=1

# Risk limits
MAX_DRAWDOWN_PCT=5.0
MAX_POSITION_PCT=2.0
DAILY_LOSS_LIMIT=10000.0

# Twitter/X API (optional — leave blank to use RSS fallback)
TWITTER_BEARER_TOKEN=

# API server
API_HOST=0.0.0.0
API_PORT=8000

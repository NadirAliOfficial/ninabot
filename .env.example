IBKR_ACCOUNT=UXXXXXXXX    # Your IBKR account number (starts with U)
TWS_PORT=7496              # 7496 = live | 7497 = paper trading
TWS_HOST=127.0.0.1        # Host for TWS connection (default localhost)
TWS_CLIENT_ID=1           # Client ID for TWS API
MAX_DRAWDOWN_PCT=5.0       # Maximum drawdown percentage before auto kill
MAX_POSITION_PCT=2.0       # Maximum position size as percent of capital
DAILY_LOSS_LIMIT=10000.0   # Daily loss limit in euros
TWITTER_BEARER_TOKEN=      # Optional Twitter API bearer token
